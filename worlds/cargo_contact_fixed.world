        <pose>0.12 -0.24 0.10 0 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.0008125</ixx>
            <iyy>0.0015</iyy>
            <izz>0.0008125</izz>
            <ixy>0</ixy>
