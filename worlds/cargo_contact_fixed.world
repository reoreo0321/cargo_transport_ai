          <material>
            <ambient>0.65 0.68 0.65 1</ambient>
            <diffuse>0.65 0.68 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="cargo_robot">
      <pose>0 0 0.005 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.20 0 0 0</pose>
        <inertial>
          <mass>5</mass>
          <inertia>
            <ixx>0.0628333</ixx>
            <iyy>0.1287083</iyy>
            <izz>0.1862083</izz>
