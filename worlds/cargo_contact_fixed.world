            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="right_wheel_collision">
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
