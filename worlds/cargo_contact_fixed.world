            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          <contact><ode><kp>1000000.0</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.0001</min_depth></ode></contact></surface>
